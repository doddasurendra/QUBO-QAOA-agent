# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=change-me
QOPT_JWT_SECRET=generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))"
QOPT_ALLOW_REGISTRATION=false
QOPT_AGENT_DAILY_BUDGET_USD=10
QOPT_AGENT_RUN_BUDGET_USD=2

# --- AI agents (Anthropic API, billed per token; separate from any Claude subscription) ---
ANTHROPIC_API_KEY=
# QOPT_CLAUDE_MODEL=claude-opus-5-5
# QOPT_CLAUDE_FALLBACKS=1

# --- Quantum hardware (optional; each also needs the SDK extra installed) ---
QISKIT_IBM_TOKEN=
# QISKIT_IBM_INSTANCE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
QOPT_BRAKET_S3_BUCKET=
DWAVE_API_TOKEN=
