# Copy to .env and fill in. Never commit .env.
# Lines marked REQUIRED must be set for `docker compose up`; everything else has a working default.

# ---------------------------------------------------------------- REQUIRED
# PostgreSQL password used by docker-compose (letters/digits only, or URL-encode it).
POSTGRES_PASSWORD=
# JWT signing secret, ≥ 32 random characters. Production refuses to start if empty or weak. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
QOPT_JWT_SECRET=

# ---------------------------------------------------------------- platform (optional, defaults shown)
# QOPT_ENVIRONMENT=production            # compose sets this; "development" allows an ephemeral JWT secret
# QOPT_DATABASE_URL=                     # compose sets the PostgreSQL URL; default sqlite:///./data/qopt.db
# QOPT_JWT_EXPIRY_MINUTES=120
# QOPT_ALLOW_REGISTRATION=false          # self-service researcher accounts
# QOPT_CORS_ORIGINS=["http://localhost:8000"]
# QOPT_RATE_LIMIT_PER_MINUTE=240
# QOPT_AGENT_RATE_LIMIT_PER_MINUTE=10
# QOPT_MAX_UPLOAD_BYTES=5242880
# QOPT_WORKER_THREADS=4
# QOPT_JOB_TIMEOUT_S=900
# QOPT_MAX_CONCURRENT_JOBS_PER_USER=4
# QOPT_MAX_STATEVECTOR_QUBITS=22
# QOPT_FRONTEND_DIST=                    # built SPA location (the Docker image sets /app/frontend/dist)
# QOPT_DOCS_DIR=                         # markdown docs location (the Docker image sets /app/docs)
# QOPT_REDIS_URL=                        # reserved; not used by this release

# ---------------------------------------------------------------- AI agents (optional)
# Anthropic API key: billed per token, separate from any Claude subscription. Server-side only.
ANTHROPIC_API_KEY=
# QOPT_CLAUDE_MODEL=claude-opus-5-5
# QOPT_CLAUDE_FALLBACKS=1                # server-side refusal fallback; 0 disables
# QOPT_AGENT_RUN_BUDGET_USD=2
# QOPT_AGENT_DAILY_BUDGET_USD=10

# ---------------------------------------------------------------- quantum hardware (optional)
# Each also needs its SDK in the image: build with EXTRAS="[ibm]" / "[braket]" / "[dwave]".
QISKIT_IBM_TOKEN=
# QISKIT_IBM_INSTANCE=
# QISKIT_IBM_CHANNEL=ibm_quantum_platform
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=                           # alternative to the key pair
AWS_DEFAULT_REGION=us-east-1
QOPT_BRAKET_S3_BUCKET=
DWAVE_API_TOKEN=
